{
  "name": "browser-bridge-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP server that lets an AI client drive one Chrome tab through the Browser Bridge extension.",
  "type": "module",
  "bin": {
    "browser-bridge-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@browser-bridge/protocol": "*",
    "@modelcontextprotocol/sdk": "1.8.0",
    "ws": "8.18.1",
    "zod": "3.24.2",
    "zod-to-json-schema": "3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsup": "8.4.0",
    "typescript": "5.6.3"
  }
}
